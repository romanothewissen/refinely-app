{
  "name": "refinely",
  "version": "1.0.0",
  "description": "Refinely: AI-powered Jira story generator by Smartif.ai",
  "main": "src/resolvers/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cd src/frontend && npm run build",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:frontend": "cd src/frontend && npm run build",
    "audit:backend": "npm audit --omit=dev --audit-level=high",
    "audit:frontend": "cd src/frontend && npm audit --omit=dev --audit-level=high",
    "audit": "npm run audit:backend && npm run audit:frontend",
    "test": "npm run test:backend",
    "test:backend": "npm run build:backend && node --test dist/core/__tests__/*.test.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run audit"
  },
  "dependencies": {
    "@forge/api": "^5.0.0",
    "@forge/bridge": "5.14.1",
    "@forge/events": "^2.0.0",
    "@forge/kvs": "^0.1.4",
    "@forge/llm": "^0.6.1",
    "@forge/resolver": "^1.7.1",
    "@forge/storage": "^2.0.3",
    "pdf-parse": "^1.1.1",
    "uuid": "^10.0.0"
  },
  "overrides": {
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
